<Window x:Class="_101OkeyLegends.Okey101Game.UI.Views.LobbyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_101OkeyLegends.Okey101Game.UI.ViewModels"
        xmlns:vm="clr-namespace:_101OkeyLegends.Okey101Game.UI.ViewModels"
        mc:Ignorable="d"
        Title="101 Okey - Lobi"
        Width="400" Height="500" ResizeMode="NoResize">
    <Window.DataContext>
        <vm:LobbyViewModel />
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kullanıcı Adı Girişi -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,10">
            <TextBlock Text="Oyuncu Adı:" FontWeight="Bold" />
            <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" Width="250" />
        </StackPanel>

        <!-- Bağlan Butonu -->
        <Button Grid.Row="1" Content="Bağlan" Command="{Binding ConnectCommand}" Width="250" Height="30" Background="Green" Foreground="White"/>

        <!-- Oyuncu Listesi -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,20,0,20">
            <TextBlock Text="Bağlı Oyuncular" FontWeight="Bold" />
            <ListBox ItemsSource="{Binding Players}" Width="250" Height="200">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!-- Oyunu Başlat Butonu -->
        <Button Grid.Row="3" Content="Oyunu Başlat"
                Command="{Binding StartGameCommand}"
                Width="250" Height="40"
                Background="Blue" Foreground="White"/>
    </Grid>
</Window>
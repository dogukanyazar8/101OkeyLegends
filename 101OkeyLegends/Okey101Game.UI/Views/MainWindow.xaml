<Window x:Class="_101OkeyLegends.Okey101Game.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_101OkeyLegends.Okey101Game.UI.Views"
        xmlns:vm="clr-namespace:_101OkeyLegends.Okey101Game.UI.Views"
        mc:Ignorable="d"
        Title="101 Okey Legends" Height="600" Width="800">

    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Üst kısımda Oyunu Başlat butonu -->
        <Button Content="Oyunu Başlat" Command="{Binding StartGameCommand}" 
                Width="250" Height="50" HorizontalAlignment="Center"/>
        <!-- Alt kısımda 4 ayrı ListBox -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Oyuncu 1 -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Oyuncu 1" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding Player1Tiles}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Oyuncu 2 -->
            <StackPanel Grid.Column="1">
                <TextBlock Text="Oyuncu 2" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding Player2Tiles}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Oyuncu 3 -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Oyuncu 3" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding Player3Tiles}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!-- Oyuncu 4 -->
            <StackPanel Grid.Column="3">
                <TextBlock Text="Oyuncu 4" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox ItemsSource="{Binding Player4Tiles}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>
    </Grid>
</Window>